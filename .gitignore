# Rust ビルド成果物
/target/

# Cargo.lock はコミット対象（T0-005）。
# TraceForge はバイナリ crate（cli）を含む workspace であり、
# 互換性仕様書 §11 により依存 pin を徹底して再現性を保証するため、バージョン管理する。

# IDE・エディタ
/.idea/
/.vscode/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# ローカル環境
.env
.env.local

# センシティブ（forensic 対象データを誤ってコミットしない）
*.dmp
*.evtx
*.vmdk
*.raw
*.dd
*.img

# fuzzing / benchmark 一時成果物
/fuzz/artifacts/
/fuzz/corpus/
# fuzz crate は workspace 外の独立 crate であり、lock と target は
# 環境依存で変わるためバージョン管理しない（cargo-fuzz 標準）。
/fuzz/Cargo.lock
/fuzz/target/
/criterion/
